{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "simple-block/cta-box",
  "title": "CTA Box",
  "category": "widgets",
  "icon": "megaphone",
  "description": "A box with a title, text and a button.",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "content": {
      "type": "string",
      "default": ""
    },
    "buttonText": {
      "type": "string",
      "default": "Learn more"
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "buttonColor": {
      "type": "string",
      "default": "#1e1e1e"
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "editorScript": "simple-block-editor",
  "style": "file:./style.css"
}